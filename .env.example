# Copy to .env and fill in. Never commit .env.

# API keys (free tier; add as many numbered keys as you like)
GEMINI1=
GEMINI2=
GROQ1=
GROQ2=
GROQ3=
TAVILY1=
TAVILY2=
TAVILY3=

# Database 
# Leave empty for local use: a SQLite file is created for you and the library loads itself.
# For hosting, paste a Supabase Postgres connection string.
DATABASE_URL=

# Key pools: comma-separated VARIABLE NAMES, tried in order / rotated
# Leave empty to auto-detect every GEMINI<n> / GROQ<n> / TAVILY<n> variable.
GEMINI_KEYS=
GROQ_KEYS=
TAVILY_KEYS=

# Model controls
# Providers are tried left to right; the next one is the fallback.
LLM_PROVIDER_ORDER=gemini,groq
# Models are tried left to right on a key: a model that is out of quota or retired for the key
# (404/429) falls through to the next. Check availability with scripts/check_connections.py --models
GEMINI_MODELS=gemini-3.5-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-3.1-flash-lite
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
# Groq's free tier allows only ~8k tokens/minute, so it gets a trimmed prompt (emergency fallback)
GROQ_MAX_PROMPT_CHARS=12000
GROQ_MAX_TOKENS=4500

# Timeouts and limits (seconds) 
HTTP_READ_TIMEOUT=30
CHECK_TIMEOUT=15
GENERATION_DEADLINE=150
SSE_HEARTBEAT=10
STATUS_CACHE_TTL=30
LLM_TIMEOUT=120
LLM_MAX_TOKENS=24000
# Gemini 2.5 "thinking" tokens share the output budget; cap them (-1 = model default). Ignored by other models.
GEMINI_THINKING_BUDGET=1024

# Research / generation 
GUIDE_FRESH_DAYS=30
SEARCH_RESULTS_PER_QUERY=5
MAX_SOURCES=10
SOURCE_CHAR_LIMIT=9000
DAILY_CAP_PER_IP=5
DAILY_CAP_GLOBAL=150

# Server 
# Comma-separated list of allowed frontend origins (CORS)
CORS_ORIGINS=http://localhost:5173
